{
  "id": "qnaChatQdrant0001",
  "name": "RAG 02 - QnA Chat (Qdrant)",
  "active": true,
  "nodes": [
    {
      "parameters": {
        "public": true,
        "options": {
          "title": "Enterprise Policy Q&A Bot",
          "subtitle": "Ask about IT support, HR and company policies"
        }
      },
      "id": "b2222222-0000-0000-0000-000000000001",
      "name": "When chat message received",
      "type": "@n8n/n8n-nodes-langchain.chatTrigger",
      "typeVersion": 1.5,
      "position": [
        -400,
        0
      ],
      "webhookId": "rag-qna-chat-qdrant"
    },
    {
      "parameters": {
        "query": "={{ $json.chatInput }}",
        "options": {
          "systemPromptTemplate": "You are a strict retrieval-grounded assistant for an internal enterprise knowledge base. Answer ONLY using the Context below — do not use any outside knowledge, even if you happen to know the answer. If the Context does not contain enough information to answer, respond exactly: \"I don't know - this isn't in the knowledge base. Please contact IT/HR support.\" Do not guess or generalize beyond what the Context says.\n----------------\nContext: {context}"
        }
      },
      "id": "b2222222-0000-0000-0000-000000000002",
      "name": "Question and Answer Chain",
      "type": "@n8n/n8n-nodes-langchain.chainRetrievalQa",
      "typeVersion": 1.6,
      "position": [
        -160,
        0
      ]
    },
    {
      "parameters": {
        "model": "llama3.2:3b",
        "options": {
          "temperature": 0.2
        }
      },
      "id": "b2222222-0000-0000-0000-000000000003",
      "name": "Ollama Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOllama",
      "typeVersion": 1,
      "position": [
        -260,
        220
      ],
      "credentials": {
        "ollamaApi": {
          "id": "rag-ollama-cred-01",
          "name": "Ollama (local)"
        }
      }
    },
    {
      "parameters": {
        "topK": 4
      },
      "id": "b2222222-0000-0000-0000-000000000004b",
      "name": "Vector Store Retriever",
      "type": "@n8n/n8n-nodes-langchain.retrieverVectorStore",
      "typeVersion": 1,
      "position": [
        -40,
        220
      ]
    },
    {
      "parameters": {
        "mode": "retrieve",
        "qdrantCollection": {
          "__rl": true,
          "mode": "id",
          "value": "enterprise_kb"
        },
        "options": {}
      },
      "id": "b2222222-0000-0000-0000-000000000004",
      "name": "Knowledge Base (Qdrant)",
      "type": "@n8n/n8n-nodes-langchain.vectorStoreQdrant",
      "typeVersion": 1.3,
      "position": [
        60,
        420
      ],
      "credentials": {
        "qdrantApi": {
          "id": "rag-qdrant-cloud-01",
          "name": "Qdrant Cloud (free tier)"
        }
      }
    },
    {
      "parameters": {
        "model": "nomic-embed-text:latest"
      },
      "id": "b2222222-0000-0000-0000-000000000005",
      "name": "Embeddings Ollama",
      "type": "@n8n/n8n-nodes-langchain.embeddingsOllama",
      "typeVersion": 1,
      "position": [
        60,
        620
      ],
      "credentials": {
        "ollamaApi": {
          "id": "rag-ollama-cred-01",
          "name": "Ollama (local)"
        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "b2222222-out-0001",
              "name": "output",
              "value": "={{ $json.response }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "b2222222-0000-0000-0000-000000000006",
      "name": "Format Chat Reply",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        100,
        0
      ]
    }
  ],
  "connections": {
    "When chat message received": {
      "main": [
        [
          {
            "node": "Question and Answer Chain",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Question and Answer Chain": {
      "main": [
        [
          {
            "node": "Format Chat Reply",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ollama Chat Model": {
      "ai_languageModel": [
        [
          {
            "node": "Question and Answer Chain",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    },
    "Vector Store Retriever": {
      "ai_retriever": [
        [
          {
            "node": "Question and Answer Chain",
            "type": "ai_retriever",
            "index": 0
          }
        ]
      ]
    },
    "Knowledge Base (Qdrant)": {
      "ai_vectorStore": [
        [
          {
            "node": "Vector Store Retriever",
            "type": "ai_vectorStore",
            "index": 0
          }
        ]
      ]
    },
    "Embeddings Ollama": {
      "ai_embedding": [
        [
          {
            "node": "Knowledge Base (Qdrant)",
            "type": "ai_embedding",
            "index": 0
          }
        ]
      ]
    }
  }
}